# ==========================================
# GiftSense 後端環境變數範例檔
# 取得個人免費氣象署 API 授權碼：https://opendata.cwa.gov.tw/user/authkey
# ==========================================

CWA_API_KEY=your_cwa_api_key_here

# ---------- 社群登入（後端驗證 token 用）----------
# Google OAuth Client ID（Web 類型；多個用逗號分隔）
GOOGLE_CLIENT_IDS=348160522222-d1ltoloj7gtcid9cd1fq6toe803djhor.apps.googleusercontent.com
# Facebook App（https://developers.facebook.com/apps）— App Secret 只能放後端
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
# Apple：iOS Bundle ID 與 Android/Web 使用的 Services ID（逗號分隔）
APPLE_CLIENT_IDS=com.example.giftsense,com.example.giftsense.signin
ANDROID_PACKAGE_NAME=com.example.giftsense

# ---------- LINE 官方帳號 ----------
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
# 選填：官方帳號 ID（例如 @123abcde），未填時後端會自動向 LINE 查詢
LINE_BOT_BASIC_ID=

# ---------- 選填：Gemini（AI 關懷語錄 / AI 晶片）----------
GEMINI_API_KEY=

# ---------- 雲端資料庫（建議：Render 免費方案重啟會清空本機 caregift.db）----------
# Turso（https://turso.tech，免費方案）：設定後資料存在 Turso，不會因 Render 休眠／重新部署而消失
# 未設定時使用本機 backend/caregift.db。設定步驟見 docs/TURSO_SETUP.md
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
